# Taleem Se Taraqqi Environment Configuration

# Database
POSTGRES_USER=tst_user
POSTGRES_PASSWORD=tst_secure_password_2026
POSTGRES_DB=taleem_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tst_user:tst_secure_password_2026@localhost:5432/taleem_db
SYNC_DATABASE_URL=postgresql://tst_user:tst_secure_password_2026@localhost:5432/taleem_db

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=taleem-packs

# Application Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev_mode
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=dev

# LLM Providers (Pluggable)
LLM_PROVIDER=stub # Options: stub, anthropic, openai, gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
